# dependencias y cachés
video/node_modules/
.venv/
.venv-tts/
.cache/
__pycache__/
.pytest_cache/
*.pyc

# configuración local (rutas de cada máquina)
config.json

# salidas: nunca van a git (videos, audios, análisis de grabaciones)
work/
entregables/
